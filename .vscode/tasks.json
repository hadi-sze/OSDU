{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "OSDU API",
			"type": "shell",
			"command": "dotnet",
			"args": [
				"run",
				"--project",
				"OSDU.Api/OSDU.Api.csproj",
				"--launch-profile",
				"http"
			],
			"isBackground": true,
			"problemMatcher": [],
			"group": "build"
		},
		{
			"label": "OSDU Web",
			"type": "shell",
			"command": "npm",
			"args": [
				"--prefix",
				"OSDU.Web",
				"run",
				"dev"
			],
			"isBackground": true,
			"problemMatcher": [],
			"group": "build"
		}
	]
}